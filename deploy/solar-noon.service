[Unit]
Description=Feed today's shadow-derived time to the solar chronyd
After=chronyd-solar.service network-online.target
Wants=network-online.target
Requires=chronyd-solar.service

[Service]
Type=oneshot
User=chrony-solar
Group=chrony-solar
SupplementaryGroups=_chrony
WorkingDirectory=/opt/chrony-solar
ExecStart=/usr/bin/python3 -m solar_chrony.main -c /etc/chrony-solar/solar.toml apply
StateDirectory=solar-noon

NoNewPrivileges=yes
ProtectClock=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/chrony-solar
