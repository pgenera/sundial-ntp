[Unit]
Description=Estimate today's time from the shadows and publish it to the feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chrony-solar
Group=chrony-solar
WorkingDirectory=/opt/chrony-solar
ExecStart=/usr/bin/python3 -m solar_chrony.main -c /etc/chrony-solar/solar.toml apply
StateDirectory=solar-noon

NoNewPrivileges=yes
ProtectClock=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
