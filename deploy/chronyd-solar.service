[Unit]
Description=Solar-disciplined NTP server (chronyd without clock control)
Documentation=man:chronyd(8)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=_chrony
Group=_chrony
ExecStart=/usr/sbin/chronyd -n -6 -x -U -u _chrony -f /etc/chrony-solar/chrony.conf
Restart=on-failure

# Only privilege: binding :123.  No CAP_SYS_TIME, and clock syscalls are
# blocked outright, so this instance cannot move the system clock.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectClock=yes
SystemCallFilter=~@clock
SystemCallArchitectures=native

RuntimeDirectory=chrony-solar
RuntimeDirectoryMode=0770
StateDirectory=chrony-solar
LogsDirectory=chrony-solar

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
